# All settings are optional: with none set, the app runs fully offline with built-in personalisation.

# AI on Google Cloud (recommended): Gemini on Vertex AI using the Cloud Run service account (no key)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# AI via the public Gemini API (alternative, needs a key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=0
RATE_LIMIT_PER_MIN=30
